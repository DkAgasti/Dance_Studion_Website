// ASM Dance Studio — Prisma schema
// Database: PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────
enum AdmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TrialStatus {
  NEW
  ATTENDED
  CONVERTED
  NO_SHOW
}

enum FeeStatus {
  PENDING
  PAID
  OVERDUE
}

enum PlanInterval {
  MONTHLY
  QUARTERLY
}

enum MediaType {
  REEL
  PHOTO
  CERTIFICATE
  REVIEW
}

enum VideoSource {
  UPLOAD
  YOUTUBE
  INSTAGRAM
}

enum AdminRole {
  ADMIN
  STAFF
}

enum ForWhom {
  MYSELF
  MY_CHILD
}

// ─────────────────────────────────────────────
// CORE
// ─────────────────────────────────────────────

model DanceClass {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  ageGroup    String?
  level       String?
  imageUrl    String?
  featured    Boolean  @default(false)
  order       Int      @default(0)

  batches   Batch[]
  students  Student[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Trainer {
  id         String   @id @default(cuid())
  name       String
  specialty  String?
  bio        String?
  photoUrl   String?
  socials    Json?
  order      Int       @default(0)

  batches    Batch[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Batch {
  id         String   @id @default(cuid())
  classId    String
  danceClass DanceClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  trainerId  String?
  trainer    Trainer?   @relation(fields: [trainerId], references: [id], onDelete: SetNull)

  day        String
  startTime  String
  endTime    String?
  capacity   Int        @default(20)
  studio     String?
  price      Int?
  active     Boolean    @default(true)

  students   Student[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Plan {
  id            String       @id @default(cuid())
  name          String
  tagline       String?
  monthlyPrice  Int?
  quarterlyPrice Int?
  interval      PlanInterval @default(MONTHLY)
  features      Json?
  ctaLabel      String?
  highlighted   Boolean      @default(false)
  order         Int          @default(0)

  students      Student[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

// ─────────────────────────────────────────────
// LEADS / FORMS
// ─────────────────────────────────────────────

model TrialBooking {
  id                String      @id @default(cuid())
  forWhom           ForWhom     @default(MYSELF)
  interests         String[]
  experienceLevel   String?
  ageGroup          String?
  preferredDateTime DateTime?
  name              String
  phone             String
  email             String?
  status            TrialStatus @default(NEW)
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model Admission {
  id                  String          @id @default(cuid())
  studentName         String
  dob                 DateTime?
  gender              String?
  guardianName        String?
  guardianRelationship String?
  guardianPhone       String?
  guardianEmail       String?
  phone               String
  email               String?
  address             String?
  classId             String?
  classInterest       String?
  batchId             String?
  planId              String?
  planName            String?
  consent             Boolean         @default(false)
  photoUrl            String?
  source              String?
  notes               String?
  status              AdmissionStatus @default(PENDING)

  student       Student?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model CorporateRequest {
  id        String   @id @default(cuid())
  name      String
  company   String?
  phone     String?
  email     String?
  message   String?
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// STUDENTS & FEES
// ─────────────────────────────────────────────

model Student {
  id          String    @id @default(cuid())
  code        String?   @unique
  admissionId String?   @unique
  admission   Admission? @relation(fields: [admissionId], references: [id], onDelete: SetNull)

  name        String
  dob         DateTime?
  guardian    String?
  guardianPhone    String?
  guardianRelation String?
  phone       String
  email       String?
  address     String?

  classId     String?
  danceClass  DanceClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
  className   String?
  batchId     String?
  batch       Batch?      @relation(fields: [batchId], references: [id], onDelete: SetNull)
  batchLabel  String?
  planId      String?
  plan        Plan?       @relation(fields: [planId], references: [id], onDelete: SetNull)
  planLabel   String?

  joinDate    DateTime   @default(now())
  active      Boolean    @default(true)

  fees        Fee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Fee {
  id                String     @id @default(cuid())
  studentId         String
  student           Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  amount            Int
  dueDate           DateTime
  status            FeeStatus  @default(PENDING)
  paidAt            DateTime?
  note              String?

  reminderLogs      ReminderLog[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([status, dueDate])
}

model ReminderLog {
  id        String   @id @default(cuid())
  feeId     String
  fee       Fee      @relation(fields: [feeId], references: [id], onDelete: Cascade)
  type      String
  channel   String
  sentAt    DateTime @default(now())

  @@unique([feeId, type])
}

// ─────────────────────────────────────────────
// CONTENT
// ─────────────────────────────────────────────

model Media {
  id          String      @id @default(cuid())
  type        MediaType
  url         String
  videoSource VideoSource?
  imageUrl    String?
  caption     String?
  category    String?
  rating      Int?
  authorName  String?
  featured    Boolean      @default(false)
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  text      String?
  link      String?
  active    Boolean  @default(false)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// SETTINGS & ADMIN
// ─────────────────────────────────────────────

model StudioSettings {
  id            String   @id @default("main")
  name          String   @default("ASM Dance Studio")
  tagline       String?
  logoUrl       String?
  address       String?
  phone         String?
  whatsapp      String?
  email         String?
  hours         Json?
  socials       Json?
  mapEmbed      String?
  heroHeading   String?
  heroSubtext   String?
  heroImageUrl  String?
  heroVideoUrl  String?
  stats         Json?
  reminderConfig Json?
  updatedAt     DateTime @updatedAt
}

model AdminUser {
  id         String    @id
  email      String    @unique
  name       String?
  role       AdminRole @default(STAFF)
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
}